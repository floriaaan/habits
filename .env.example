# Copie locale facultative : aucune identité ni secret de production.
# cargo run ne charge pas automatiquement ce fichier ; exporter les variables.
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/habits.sqlite
AUTH_MODE=disabled
RUST_LOG=habit_tracker=info,tower_http=info

# Docker Compose utilise ses propres chemins/adresse internes.
HOST_PORT=8080

# Contrats futurs, laissés COMMENTÉS : non implémentés et non activables.
