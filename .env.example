# Copie locale facultative : aucune identité ni secret de production.
# cargo run ne charge pas automatiquement ce fichier ; exporter les variables.
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/habits.sqlite
AUTH_MODE=disabled
RUST_LOG=habit_tracker=info,tower_http=info

# Logs OTLP HTTP JSON facultatifs : URL complète du receiver /v1/logs.
# Vide = console JSON seulement. HTTP seulement sur réseau local de confiance.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Headers OTLP optionnels fournis par votre collecteur ; ne pas committer de secrets.
OTEL_EXPORTER_OTLP_LOGS_HEADERS=
OTEL_SERVICE_NAME=habit-tracker

# Docker Compose utilise ses propres chemins/adresse internes.
HOST_PORT=8080
# Bloc Compose GHCR du README uniquement : image et publication du port hôte.
HABIT_TRACKER_TAG=latest
HOST_BIND=127.0.0.1

# AUTH_MODE=local : utilisateur unique et premier PAT créés automatiquement.
# Le PAT initial est affiché une seule fois dans les logs et expire après 24 h.
# AUTH_MODE=oidc : contrat access token RFC 9068 requis (docs/auth.md).
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_ALLOWED_ALGORITHMS=
# OIDC_ACCESS_TOKEN_TYP=
# Clé base64 de 32 octets et identifiant, obligatoires pour les connecteurs.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_ID=
# Connecteurs facultatifs ; ne renseigner qu'un groupe complet.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=
# STRAVA_WEBHOOK_VERIFY_TOKEN=
# STRAVA_WEBHOOK_PATH_TOKEN=
# STRAVA_SUBSCRIPTION_ID=
# STRAVA_ATHLETE_CAPACITY=
# STRAVA_MULTI_ATHLETE_APPROVED=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_ALLOW_HTTP=
