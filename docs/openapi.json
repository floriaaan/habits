  "components": {
    "schemas": {
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "habit_id",
          "user_id",
          "occurred_at",
          "local_date",
          "value",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "habit_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "local_date": {
            "type": "string",
            "format": "date"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EntryPage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "Habit": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NewHabit"
          },
          {
            "type": "object",
            "required": [
              "id",
              "user_id",
              "created_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "user_id": {
                "$ref": "#/components/schemas/UserId"
              }
            }
          }
        ]
      },
      "HabitKind": {
        "type": "string",
        "enum": [
          "boolean",
          "quantity",
          "duration",
          "frequency"
        ]
      },
      "HabitPage": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Habit"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "NewEntry": {
        "type": "object",
        "required": [
          "occurred_at",
          "value"
        ],
        "properties": {
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "NewHabit": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "unit",
          "target",
          "timezone"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/HabitKind"
          },
          "name": {
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "target": {
            "type": "number",
            "format": "double"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone, e.g. Europe/Paris."
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          }
        },
        "additionalProperties": false
      },
      "Schedule": {
        "type": "object",
        "required": [
          "weekdays"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "ISO weekdays, Monday=1, Sunday=7; unique and non-empty."
          }
        },
        "additionalProperties": false
      },
      "Unit": {
        "type": "string",
        "enum": [
          "count",
          "meters",
          "seconds",
          "milliliters"
        ]
      },
      "UserId": {
        "type": "string",
        "format": "uuid"
      },
      "Version": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Contract only: runtime refuses all private requests in iteration 1"
      }
    }
  }
}
