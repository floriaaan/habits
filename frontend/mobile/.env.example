EXPO_PUBLIC_CONNECTOR_MODE=fake
# HTTP mode: origin only, no /api/v1 suffix. iOS simulator: localhost;
# Android emulator: 10.0.2.2; physical device: LAN IP or reachable HTTPS domain.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
# Development only; never permits cleartext in a release bundle.
EXPO_PUBLIC_ALLOW_HTTP=true
# Optional public OIDC client configuration (no client secret).
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_AUDIENCE=
EXPO_PUBLIC_OIDC_SCOPES=openid habits:read habits:write entries:read entries:write statistics:read
